Pine Script – nPeriod Candle AI Vol TF1/6.A (SL di ekor panjang, no-trade saat flip)
//@version=5
indicator("nPeriod_Candle AI Vol TF1/6.A", overlay=true, timeframe="60")

// === INPUT UTAMA ===
Length      = input.int(6, "Length (n-Period)", minval = 2)
Len         = Length - 1
volAvgLen   = input.int(20, "Volume SMA Length", minval = 5)
wickFactor  = input.float(1.2, "Wick Panjang = wick > faktor * body", minval = 0.5, step = 0.1)

// === FUNGSI DONCHIAN ===
donchianLow(len)  => ta.lowest(len)
donchianHigh(len) => ta.highest(len)

// === N-PERIOD CANDLE (6 bar default) ===
m_close = close
m_open  = open[Len]
m_high  = donchianHigh(Len)
m_low   = donchianLow(Len)

// Warna candle gabungan
isBull = m_close > m_open
isBear = m_close < m_open

candleColor = isBull ? color.white : color.blue

plotcandle(
     open  = m_open,
     high  = m_high,
     low   = m_low,
     close = m_close,
     title = "nPeriod Candle",
     color = candleColor,
     wickcolor = color.black
)

// === "AI" RULES: VOLUME + RANGE + BODY ===

// Volume filter: volume di atas rata-rata
volAvg      = ta.sma(volume, volAvgLen)
highVolume  = volume > volAvg

// Range & body untuk mengukur kekuatan candle gabungan
range       = m_high - m_low
avgRange    = ta.sma(range, 20)
body        = math.abs(m_close - m_open)

// Body besar bila > 60% dari range
bodyBig     = body > 0.6 * range
// Range besar bila > rata-rata 20 bar
rangeBig    = range > avgRange

// Strong Buy/Sell: arah candle + volume tinggi + range besar + body besar
strongBull = isBull and highVolume and rangeBig and bodyBig
strongBear = isBear and highVolume and rangeBig and bodyBig

// === EKOR PANJANG UNTUK STOP LOSS ===
// Hitung wick atas & bawah gabungan
upperWick = m_high - math.max(m_open, m_close)
lowerWick = math.min(m_open, m_close) - m_low

// Definisi ekor panjang: wick > wickFactor * body
longUpperWick = upperWick > wickFactor * body
longLowerWick = lowerWick > wickFactor * body

// Stop loss berbasis ekor panjang
// Buy: kalau ada ekor bawah panjang → stop di bawah ekor panjang
//      kalau tidak ada ekor panjang, fallback ke low n-period
// Sell: kalau ada ekor atas panjang → stop di atas ekor panjang
//       kalau tidak ada, fallback ke high n-period
bullSL_wick = longLowerWick ? (m_low) : m_low
bearSL_wick = longUpperWick ? (m_high) : m_high

// === DETEKSI FLIP (sinyal berbalik arah) ===
var int lastSignal = 0   // 1 = buy, -1 = sell, 0 = none
currSignal = strongBull ? 1 : strongBear ? -1 : 0
flip       = currSignal != 0 and lastSignal != 0 and currSignal != lastSignal

if barstate.isconfirmed
    if currSignal != 0
        lastSignal := currSignal

// === PERKIRAAN TARGET (1–6–10 candle) ===
// Asumsi avgRange kira-kira jarak 1 candle
factor1   = 1.0
factor3   = 3.0
factor6   = 6.0
factor10  = 10.0

bullTP1  = m_close + factor1  * avgRange
bullTP3  = m_close + factor3  * avgRange
bullTP6  = m_close + factor6  * avgRange
bullTP10 = m_close + factor10 * avgRange

bearTP1  = m_close - factor1  * avgRange
bearTP3  = m_close - factor3  * avgRange
bearTP6  = m_close - factor6  * avgRange
bearTP10 = m_close - factor10 * avgRange

// === LABEL SINYAL DENGAN FORMAT TF1/6.A ===
var label lastLabel = na

if barstate.isconfirmed
    // Hapus label lama supaya chart gak terlalu penuh
    if not na(lastLabel)
        label.delete(lastLabel)

    // Kalau FLIP: NO TRADE, abaikan SL/TP
    if flip
        lastLabel := label.new(
             bar_index, m_high,
             "FLIP – No Trade\nTF1/6.A",
             style = label.style_label_down,
             color = color.orange,
             textcolor = color.black
        )
    else
        // Hanya kalau BUKAN flip, baru tampilkan SL & TP
        if strongBull
            txtBull = "STRONG BUY TF1/6.A\n" +
                      "SL (ekor panjang): " + str.tostring(bullSL_wick, format.mintick) + "\n" +
                      "TP1 (~1 candle): " + str.tostring(bullTP1, format.mintick) + "\n" +
                      "TP2 (~3 candle): " + str.tostring(bullTP3, format.mintick) + "\n" +
                      "TP3 (~6 candle): " + str.tostring(bullTP6, format.mintick) + "\n" +
                      "Jika >6 candle (~10): " + str.tostring(bullTP10, format.mintick)
            lastLabel := label.new(
                 bar_index, m_low,
                 txtBull,
                 style = label.style_label_up,
                 color = color.new(color.lime, 0),
                 textcolor = color.black
            )
        else if strongBear
            txtBear = "STRONG SELL TF1/6.A\n" +
                      "SL (ekor panjang): " + str.tostring(bearSL_wick, format.mintick) + "\n" +
                      "TP1 (~1 candle): " + str.tostring(bearTP1, format.mintick) + "\n" +
                      "TP2 (~3 candle): " + str.tostring(bearTP3, format.mintick) + "\n" +
                      "TP3 (~6 candle): " + str.tostring(bearTP6, format.mintick) + "\n" +
                      "Jika >6 candle (~10): " + str.tostring(bearTP10, format.mintick)
            lastLabel := label.new(
                 bar_index, m_high,
                 txtBear,
                 style = label.style_label_down,
                 color = color.new(color.red, 0),
                 textcolor = color.white
            )

// === "AI" TRENDLINE & BREAKOUT (BO) ===
pivotLen = 5
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

// Simpan pivot low/high terakhir untuk bikin trendline
var float lastPlPrice = na
var int   lastPlIndex = na
var float lastPhPrice = na
var int   lastPhIndex = na

var line bullTrend = na
var line bearTrend = na

// Trendline bullish: hubungkan 2 pivot low terakhir
if not na(pl)
    if na(lastPlPrice)
        lastPlPrice := pl
        lastPlIndex := bar_index - pivotLen
    else
        if not na(bullTrend)
            line.delete(bullTrend)
        bullTrend := line.new(
             lastPlIndex, lastPlPrice,
             bar_index - pivotLen, pl,
             extend = extend.right,
             color = color.lime,
             width = 1
        )
        lastPlPrice := pl
        lastPlIndex := bar_index - pivotLen

// Trendline bearish: hubungkan 2 pivot high terakhir
if not na(ph)
    if na(lastPhPrice)
        lastPhPrice := ph
        lastPhIndex := bar_index - pivotLen
    else
        if not na(bearTrend)
            line.delete(bearTrend)
        bearTrend := line.new(
             lastPhIndex, lastPhPrice,
             bar_index - pivotLen, ph,
             extend = extend.right,
             color = color.red,
             width = 1
        )
        lastPhPrice := ph
        lastPhIndex := bar_index - pivotLen

// Breakout deteksi sederhana terhadap trendline
bullBO = not na(bearTrend) and close > line.get_price(bearTrend, bar_index)
bearBO = not na(bullTrend) and close < line.get_price(bullTrend, bar_index)

// Tanda breakout
plotshape(
     bullBO,
     title="Bullish BO",
     style=shape.triangleup,
     color=color.lime,
     size=size.tiny,
     location=location.belowbar,
     text="BO"
)

plotshape(
     bearBO,
     title="Bearish BO",
     style=shape.triangledown,
     color=color.red,
     size=size.tiny,
     location=location.abovebar,
     text="BO"
)

// === OPSIONAL: INFO VOLUME ===
showVolFilter = input.bool(true, "Show Volume Filter Mark", inline="VOL")
plotVolSignal = input.bool(false, "Plot Volume Histogram", inline="VOL")

plot(
     plotVolSignal ? volume : na,
     title = "Volume (opsional)", 
     color = highVolume ? color.lime : color.gray, 
     style = plot.style_columns
)

plotchar(
     showVolFilter and highVolume,
     char = "V",
     location = location.belowbar,
     color = color.lime,
     title="High Volume Bar"
)

